{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Central Sintramomed",
  "version": "0.1.51",
  "identifier": "br.org.sintramomed.central",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Central Sintramomed",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "PortugueseBR"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwMzE2Qzc0MDkyMEJCNTAKUldSUXV5QUpkR3d4b012aWdMYmJua3k4M1ZVQ0xNRnpndEtQYUtWVnNOVXRabkxaY0VTc0dwK0cK",
      "endpoints": [
        "https://github.com/FerratoBRq/central-sintramomed/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}